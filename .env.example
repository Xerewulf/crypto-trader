# ==============================================================================
# Binance 24/7 Crypto Trader Environment Configuration
# NEVER commit your actual .env file or credentials to Git!
# ==============================================================================

# Binance API Credentials (Testnet or Production)
# Obtain testnet keys free from: https://testnet.binancefuture.com
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Mode: "testnet" (default zero-risk) or "live" (real money)
BINANCE_TESTNET=true
BINANCE_MODE=testnet

# Push Notifications (Optional but recommended)
# Create a Telegram bot via @BotFather and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Web Dashboard Security (Protects your 24/7 web interface on the open internet)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ChangeThisPasswordInCloud123!

# Server Network Config
HOST=0.0.0.0
PORT=8765
